# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
/e2e/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Chromium/crashpad stderr logs occasionally dropped into the tree (incl.
# inside route directories) — never commit them (M3 review S7).
debug.log
**/debug.log

# local env files
.env*.local
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

#yaml file
apphosting.emulator.yaml

/AI-Driven-Project

# agent loop docs and prototype reference mockups (exempt from *.md ignore)
!/agents/**
!/prototype/prototype/**

# video stills (172MB) - never commit
/prototype/keyframes/

# prototype-capture artifacts (pre-existing user files, kept locally but
# never committed — M3 review S7)
/prototype/contact_sheet.jpg
/prototype/metadata/
